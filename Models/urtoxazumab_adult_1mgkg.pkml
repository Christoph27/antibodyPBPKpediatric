        <CoreCalculationMethod name="Interstitial partition coefficient method - Schmitt" icon="CoreCalculationMethod" bbVersion="0" category="DistributionInterstitial">
          <Creation createdAt="5250922778493305889" createdBy="8aab7eaf" creationMode="New" origin="Other" />
          <OutputFormulas>
            <KeyValue>
              <Formula id="Interstitial partition coefficient method - Schmitt.PARAM_K_int_pls" name="PARAM_K_int_pls" formula="(f_water_int + f_proteins_int_to_pls * (1/fu - f_water_pls)) * fu">
                <Paths>
                  <Path path="0" as="1" dim="2" />
                  <Path path="3" as="4" />
                  <Path path="5" as="6" />
                  <Path path="7" as="8" />
                </Paths>
              </Formula>
              <ParameterDescriptor parameterName="Partition coefficient (interstitial/plasma)">
                <ContainerCriteria operator="And">
                  <DescriptorConditions>
                    <MatchTagCondition tag="Neighborhood: Plasma / Interstitial" />
                  </DescriptorConditions>
                </ContainerCriteria>
              </ParameterDescriptor>
            </KeyValue>
          </OutputFormulas>
          <HelpParameters>
