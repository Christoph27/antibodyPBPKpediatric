      <AllCalculationMethods>
        <CoreCalculationMethod name="Cellular partition coefficient method - PK-Sim Standard" icon="CoreCalculationMethod" bbVersion="0" category="DistributionCellular">
          <Creation createdAt="5250922778493202186" createdBy="8aab7eaf" creationMode="New" origin="Other" />
          <OutputFormulas>
            <KeyValue>
              <Formula id="Cellular partition coefficient method - PK-Sim Standard.PARAM_K_rbc" name="PARAM_K_rbc" formula="(f_water_rbc + f_lipids_rbc * 10^LogMA + f_proteins_rbc * KProt)*fu">
                <Paths>
                  <Path path="0" as="1" dim="2" />
                  <Path path="3" as="4" dim="5" />
                  <Path path="6" as="7" />
                  <Path path="8" as="9" />
                  <Path path="10" as="11" />
                  <Path path="12" as="13" />
                </Paths>
              </Formula>
              <ParameterDescriptor parameterName="Partition coefficient (blood cells/plasma)">
                <ContainerCriteria operator="And">
                  <DescriptorConditions>
                    <MatchTagCondition tag="RootContainer" />
                  </DescriptorConditions>
                </ContainerCriteria>
              </ParameterDescriptor>
            </KeyValue>
            <KeyValue>
              <Formula id="Cellular partition coefficient method - PK-Sim Standard.PARAM_K_cell_pls_PK-Sim_Standard" name="PARAM_K_cell_pls_PK-Sim_Standard" formula="(f_water + f_lipids * 10^LogMA + f_proteins * KProt) * fu">
                <Paths>
                  <Path path="0" as="1" dim="2" />
                  <Path path="3" as="4" dim="5" />
                  <Path path="6" as="7" />
                  <Path path="14" as="15" />
                  <Path path="16" as="17" />
                  <Path path="18" as="19" />
                </Paths>
              </Formula>
              <ParameterDescriptor parameterName="Partition coefficient (intracellular/plasma)">
                <ContainerCriteria operator="And">
                  <DescriptorConditions>
                    <MatchTagCondition tag="Neighborhood: Interstitial / Intracellular" />
                  </DescriptorConditions>
                </ContainerCriteria>
              </ParameterDescriptor>
            </KeyValue>
          </OutputFormulas>
          <HelpParameters />
          <FormulaCache>
            <StringMap>
              <Map s="MOLECULE|Fraction unbound (plasma)" id="0" />
              <Map s="fu" id="1" />
